<service>
	<id>manpasandprintserver.exe</id>
	<name>Manpasand Print Server</name>
	<description>Local print server for Pehnawa Boutique Pos receipt printing</description>
	<executable>D:\Apps\nvm\nodejs\node.exe</executable>
	<argument>--max_old_space_size=4096</argument>
	<argument>D:\New folder\Pehnava Boutique Pos\Pehnava Boutique Pos\PrintServer\node_modules\node-windows\lib\wrapper.js</argument>
	<argument>--file</argument>
	<argument>D:\New folder\Pehnava Boutique Pos\Pehnava Boutique Pos\PrintServer\server.js</argument>
	<argument>--scriptoptions=</argument>
	<argument>--log</argument>
	<argument>Manpasand Print Server wrapper</argument>
	<argument>--grow</argument>
	<argument>0.5</argument>
	<argument>--wait</argument>
	<argument>2</argument>
	<argument>--maxrestarts</argument>
	<argument>5</argument>
	<argument>--abortonerror</argument>
	<argument>n</argument>
	<argument>--stopparentfirst</argument>
	<argument>undefined</argument>
	<logmode>rotate</logmode>
	<stoptimeout>30sec</stoptimeout>
	<env name="NODE_ENV" value="production"/>
	<serviceaccount>
		<domain>TPL-LAP-000281</domain>
		<user>LocalSystem</user>
		<password></password>
	</serviceaccount>
	<workingdirectory>D:\New folder\Pehnava Boutique Pos\Pehnava Boutique Pos\PrintServer</workingdirectory>
</service>