datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String    @id @default(uuid())
  email      String    @unique
  name       String?
  password   String
  role       Role      @default(ADMIN)
  /// Inactive users cannot sign in or use existing sessions
  is_active  Boolean   @default(true)
  last_login_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now()) @updatedAt
  sessions   Session[]
  cashflows  CashFlow[]
  closed_cashflows CashFlow[] @relation("CashFlowCloser")

  branch_id String?
  branch    Branch? @relation(fields: [branch_id], references: [id])

  // Relations for tracking user actions
  sales            Sale[]
  hold_sales       HoldSale[]
  purchase_orders  PurchaseOrder[]
  stock_movements  StockMovement[]
  purchases        Purchase[]
  transfers        Transfer[]
  stock_adjustments StockAdjustment[]
  supplier_payments SupplierPayment[]
  customer_payments CustomerPayment[]
  expenses_created  Expense[]         @relation("ExpenseCreator")
  expenses_approved Expense[]         @relation("ExpenseApprover")
  recurring_expenses RecurringExpense[] @relation("RecurringExpenseCreator")
  purchase_returns  PurchaseReturn[]  @relation("PurchaseReturnCreator")
  purchase_invoices PurchaseInvoice[] @relation("PurchaseInvoiceCreator")
  employee          Employee?

  @@index([email])
}

model Session {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([user_id])
  @@index([token])
}

enum BranchType {
  WAREHOUSE
  BRANCH
}

model Branch {
  id                    String      @id @default(uuid())
  code                  String      @unique
  name                  String
  address               String?
  branch_type           BranchType  @default(BRANCH)
  allow_neg_pos_stock   Boolean     @default(false)
  allow_neg_stock_grrn  Boolean     @default(false)
  allow_neg_transferout Boolean     @default(false)
  is_active             Boolean     @default(true)
  created_at            DateTime    @default(now())
  updated_at            DateTime    @default(now()) @updatedAt
  cashflows             CashFlow[]
  expenses              Expense[]
  recurring_expenses    RecurringExpense[]
  purchase_returns      PurchaseReturn[]  @relation("PurchaseReturnBranch")
  purchase_invoices     PurchaseInvoice[] @relation("PurchaseInvoiceBranch")

  // Relations
  category           Category[]
  stock              Stock[]
  sales              Sale[]
  hold_sales         HoldSale[]
  purchase_orders     PurchaseOrder[]
  stock_movements     StockMovement[]
  Order              Order[]
  User               User[]
  employees          Employee[]
  purchases_from     Purchase[]    @relation("PurchaseWarehouse")
  transfers_from     Transfer[]    @relation("TransferFrom")
  transfers_to       Transfer[]    @relation("TransferTo")
  stock_adjustments  StockAdjustment[]

  @@index([code])
  @@index([is_active])
  @@index([branch_type])
}

model Category {
  id                  String           @id @default(uuid())
  code                String           @unique @default(dbgenerated("'CAT-' || gen_random_uuid()"))
  name                String
  slug                String           @unique
  display_on_branches String[]
  image               String?
  is_active           Boolean          @default(true)
  get_tax_from_item   Boolean          @default(false)
  editable_sale_rate  Boolean          @default(false)
  display_on_pos      Boolean          @default(true)
  products            Product[]
  branch_id           String?
  branch              Branch?          @relation(fields: [branch_id], references: [id])
  created_at          DateTime         @default(now())
  updated_at          DateTime         @default(now()) @updatedAt
  CategoryImages      CategoryImages[]

  @@index([code])
  @@index([slug])
  @@index([is_active])
  @@index([display_on_pos])
  @@index([branch_id])
}

model CategoryImages {
  id          String      @id @default(uuid())
  category_id String
  category    Category    @relation(fields: [category_id], references: [id])
  image       String
  status      ImageStatus @default(PENDING)
  error       String?
  is_active   Boolean     @default(true)
  created_at  DateTime    @default(now())

  @@index([category_id])
}

model Subcategory {
  id             String    @id @default(uuid())
  code           String    @unique
  name           String
  image          String?
  is_active      Boolean   @default(true)
  display_on_pos Boolean   @default(true)
  products       Product[]
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now()) @updatedAt

  @@index([code])
  @@index([is_active])
  @@index([display_on_pos])
}

model Color {
  id             String    @id @default(uuid())
  code           String    @unique
  name           String
  products       Product[]
  is_active      Boolean   @default(true)
  display_on_pos Boolean   @default(true)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now()) @updatedAt

  @@index([code])
  @@index([is_active])
  @@index([display_on_pos])
}

model Size {
  id             String    @id @default(uuid())
  code           String    @unique
  name           String
  products       Product[]
  is_active      Boolean   @default(true)
  display_on_pos Boolean   @default(true)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now()) @updatedAt

  @@index([code])
  @@index([is_active])
  @@index([display_on_pos])
}

model Unit {
  id             String    @id @default(uuid())
  code           String    @unique
  name           String
  is_active      Boolean   @default(true)
  display_on_pos Boolean   @default(true)
  products       Product[]
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now()) @updatedAt

  @@index([code])
  @@index([is_active])
  @@index([display_on_pos])
}

model Supplier {
  id              String          @id @default(uuid())
  code            String          @unique
  name            String
  phone_number    String?
  fax_number      String?
  mobile_number   String?
  country         String?
  city            String?
  status          String?
  email           String?
  ntn             String?
  strn            String?
  gov_id          String?
  address         String?
  is_active       Boolean         @default(true)
  display_on_pos  Boolean         @default(true)
  // Contact, terms and bank details
  contact_person       String?
  whatsapp_number      String?
  category             String?
  payment_terms        String?
  credit_days          Int?
  credit_limit         Decimal?
  opening_balance      Decimal   @default(0) // + we owe them, - they owe us (advance)
  opening_balance_date DateTime?
  bank_name            String?
  bank_account_title   String?
  bank_account_number  String?
  bank_iban            String?
  rating               Int?
  notes                String?
  products        Product[]
  purchase_orders PurchaseOrder[]
  purchases       Purchase[]
  purchase_returns PurchaseReturn[]
  purchase_invoices PurchaseInvoice[]
  payments        SupplierPayment[]
  chart_account   TransactionalAccount?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @default(now()) @updatedAt

  @@index([code])
  @@index([is_active])
  @@index([display_on_pos])
}

model SupplierPayment {
  id           String   @id @default(uuid())
  supplier_id  String
  supplier     Supplier @relation(fields: [supplier_id], references: [id], onDelete: Cascade)
  amount       Decimal
  // PAYMENT | ADVANCE | REFUND | DEBIT_NOTE | CREDIT_NOTE | DISCOUNT (amount is always positive)
  type         String   @default("PAYMENT")
  payment_date DateTime @default(now())
  method       String   @default("CASH")
  reference    String?
  notes        String?
  purchase_invoice_id String?
  purchase_invoice    PurchaseInvoice? @relation(fields: [purchase_invoice_id], references: [id])
  created_by   String
  user         User     @relation(fields: [created_by], references: [id])
  created_at   DateTime @default(now())

  @@index([supplier_id])
  @@index([payment_date])
  @@index([purchase_invoice_id])
  @@index([created_by])
}

enum PurchaseInvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

/// The supplier's bill for one or more received deliveries (GRN lines). This is
/// the tracked payable document — payments settle against it and it ages.
model PurchaseInvoice {
  id                String                @id @default(uuid())
  invoice_number    String
  supplier_id       String
  supplier          Supplier              @relation(fields: [supplier_id], references: [id])
  branch_id         String?
  branch            Branch?               @relation("PurchaseInvoiceBranch", fields: [branch_id], references: [id])
  purchase_order_id String?
  purchase_order    PurchaseOrder?        @relation(fields: [purchase_order_id], references: [id])
  invoice_date      DateTime              @default(now())
  due_date          DateTime?
  subtotal          Decimal               @default(0)
  tax_amount        Decimal               @default(0)
  discount_amount   Decimal               @default(0)
  total_amount      Decimal               @default(0)
  amount_paid       Decimal               @default(0)
  status            PurchaseInvoiceStatus @default(UNPAID)
  notes             String?
  created_by        String
  user              User                  @relation("PurchaseInvoiceCreator", fields: [created_by], references: [id])
  purchases         Purchase[]
  payments          SupplierPayment[]
  created_at        DateTime              @default(now())
  updated_at        DateTime              @default(now()) @updatedAt

  @@unique([supplier_id, invoice_number])
  @@index([supplier_id])
  @@index([branch_id])
  @@index([status])
  @@index([due_date])
}

model Tax {
  id             String    @id @default(uuid())
  code           String    @unique
  name           String
  percentage     Float
  is_active      Boolean   @default(true)
  display_on_pos Boolean   @default(true)
  products       Product[]
  created_at     DateTime  @default(now())

  @@index([code])
  @@index([is_active])
  @@index([display_on_pos])
}

model Brand {
  id             String    @id @default(uuid())
  code           String    @unique
  name           String
  display_on_pos Boolean   @default(true)
  is_active      Boolean   @default(true)
  products       Product[]
  created_at     DateTime  @default(now())

  @@index([code])
  @@index([is_active])
  @@index([display_on_pos])
}

model Product {
  id                         String       @id @default(uuid())
  code                       String       @unique
  name                       String
  unit_id                    String       @default("00000000-0000-0000-0000-000000000000")
  unit                       Unit         @relation(fields: [unit_id], references: [id])
  pct_or_hs_code             String?
  description                String?
  sku                        String       @unique
  purchase_rate              Decimal      @default(0)
  sales_rate_exc_dis_and_tax Decimal      @default(0)
  sales_rate_inc_dis_and_tax Decimal      @default(0)
  discount_amount            Decimal?     @default(0)
  tax_id                     String?
  tax                        Tax?         @relation(fields: [tax_id], references: [id])
  category_id                String       @default("00000000-0000-0000-0000-000000000000")
  category                   Category     @relation(fields: [category_id], references: [id])
  subcategory_id             String?
  subcategory                Subcategory? @relation(fields: [subcategory_id], references: [id])
  min_qty                    Int?         @default(0)
  max_qty                    Int?         @default(0)
  supplier_id                String?
  supplier                   Supplier?    @relation(fields: [supplier_id], references: [id])
  brand_id                   String?
  brand                      Brand?       @relation(fields: [brand_id], references: [id])
  color_id                   String?
  color                      Color?       @relation(fields: [color_id], references: [id])
  size_id                    String?
  size                       Size?        @relation(fields: [size_id], references: [id])
  is_featured                Boolean      @default(false)
  is_active                  Boolean      @default(true)
  display_on_pos             Boolean      @default(true)
  display_on_website         Boolean      @default(true)
  is_batch                   Boolean      @default(false)
  auto_fill_on_demand_sheet  Boolean      @default(false)
  non_inventory_item         Boolean      @default(false)
  is_deal                    Boolean      @default(false)
  has_images                 Boolean      @default(false)
  is_finished_good           Boolean      @default(true)
  is_loose_item              Boolean      @default(false)
  /// Season / collection label, e.g. "Eid 2026", "Winter Luxe"
  collection                 String?
  price_history              ProductPriceHistory[]

  // Relations
  order_items          OrderItem[]
  sale_items           SaleItem[]
  stock                Stock[]
  purchase_order_items PurchaseOrderItem[]
  stock_movements      StockMovement[]
  ProductImage         ProductImage[]
  purchases            Purchase[]
  purchase_return_items PurchaseReturnItem[]
  stock_adjustments    StockAdjustment[]
  transfers            Transfer[]
  created_at           DateTime            @default(now())
  updated_at           DateTime            @default(now()) @updatedAt

  @@index([code])
  @@index([category_id])
  @@index([subcategory_id])
  @@index([sku])
  @@index([supplier_id])
  @@index([brand_id])
  @@index([color_id])
  @@index([size_id])
  @@index([is_featured])
  @@index([is_active])
  @@index([display_on_pos])
  @@index([display_on_website])
}

enum ImageStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

model ProductImage {
  id         String      @id @default(uuid())
  product_id String
  product    Product     @relation(fields: [product_id], references: [id])
  image      String
  status     ImageStatus @default(PENDING)
  error      String?
  is_active  Boolean     @default(true)
  created_at DateTime    @default(now())

  @@index([product_id])
}

// NEW: Stock Management
model Stock {
  id                String   @id @default(uuid())
  product_id        String
  product           Product  @relation(fields: [product_id], references: [id])
  branch_id         String
  branch            Branch   @relation(fields: [branch_id], references: [id])
  current_quantity  Decimal  @default(0)
  reserved_quantity Decimal  @default(0)
  minimum_quantity  Decimal  @default(0)
  maximum_quantity  Decimal?
  reorder_level     Decimal?
  last_updated      DateTime @default(now()) @updatedAt
  created_at        DateTime @default(now())

  @@unique([product_id, branch_id])
  @@index([product_id])
  @@index([branch_id])
  @@index([current_quantity])
}

// NEW: Stock Movement History
model StockMovement {
  id              String            @id @default(uuid())
  product_id      String
  product         Product           @relation(fields: [product_id], references: [id])
  branch_id       String
  branch          Branch            @relation(fields: [branch_id], references: [id])
  movement_type   StockMovementType
  reference_id    String? // Links to sale_id, purchase_order_id, etc.
  reference_type  String? // 'sale', 'purchase', 'adjustment', 'transfer'
  quantity_change Decimal // Positive for in, negative for out
  previous_qty    Decimal
  new_qty         Decimal
  unit_cost       Decimal?
  notes           String?
  created_by      String?
  user            User?             @relation(fields: [created_by], references: [id])
  created_at      DateTime          @default(now())

  @@index([product_id])
  @@index([branch_id])
  @@index([movement_type])
  @@index([reference_id])
  @@index([created_at])
}

enum PurchaseDeliveryStatus {
  PARTIAL
  COMPLETE
}

model Purchase {
  id                String                 @id @default(uuid())
  product_id         String
  product            Product                @relation(fields: [product_id], references: [id])
  supplier_id        String
  supplier           Supplier               @relation(fields: [supplier_id], references: [id])
  warehouse_branch_id String
  warehouse_branch   Branch                 @relation("PurchaseWarehouse", fields: [warehouse_branch_id], references: [id])
  quantity           Decimal
  cost_price         Decimal
  sale_price         Decimal
  purchase_date      DateTime               @default(now())
  invoice_ref        String?
  /// Shared id for all lines from one Stock In save (one supplier bill / GRN).
  bill_group_id      String?
  notes              String?
  delivery_status    PurchaseDeliveryStatus  @default(COMPLETE)
  purchase_order_id  String?
  purchase_order     PurchaseOrder?          @relation(fields: [purchase_order_id], references: [id])
  purchase_invoice_id String?
  purchase_invoice   PurchaseInvoice?        @relation(fields: [purchase_invoice_id], references: [id])
  return_items       PurchaseReturnItem[]
  created_by         String
  user               User                   @relation(fields: [created_by], references: [id])
  created_at         DateTime               @default(now())

  @@index([product_id])
  @@index([supplier_id])
  @@index([warehouse_branch_id])
  @@index([purchase_date])
  @@index([purchase_order_id])
  @@index([purchase_invoice_id])
  @@index([bill_group_id])
  @@index([created_by])
}

enum TransferStatus {
  PENDING
  DISPATCHED
  RECEIVED
  CANCELLED
}

model Transfer {
  id              String         @id @default(uuid())
  product_id      String
  product         Product        @relation(fields: [product_id], references: [id])
  quantity        Decimal
  from_branch_id  String
  from_branch     Branch         @relation("TransferFrom", fields: [from_branch_id], references: [id])
  to_branch_id    String
  to_branch       Branch         @relation("TransferTo", fields: [to_branch_id], references: [id])
  status          TransferStatus @default(PENDING)
  transfer_date   DateTime       @default(now())
  reference_no    String?        @unique
  reason          String?        @default("Stock Replenishment")
  carrier_name    String?
  vehicle_no      String?
  estimated_arrival DateTime?
  receiver_name   String?
  notes           String?
  created_by      String
  user            User           @relation(fields: [created_by], references: [id])
  received_at     DateTime?
  received_by     String?
  created_at      DateTime       @default(now())

  @@index([product_id])
  @@index([from_branch_id])
  @@index([to_branch_id])
  @@index([status])
  @@index([transfer_date])
}

enum StockAdjustmentType {
  ADDITION
  SUBTRACTION
  RECONCILIATION
}

enum StockAdjustmentCategory {
  CORRECTION
  DAMAGE
  EXPIRED
  THEFT
  RETURN_TO_SUPPLIER
  ADMINISTRATIVE
}

model StockAdjustment {
  id                  String                  @id @default(uuid())
  product_id          String
  product             Product                 @relation(fields: [product_id], references: [id])
  branch_id           String
  branch              Branch                  @relation(fields: [branch_id], references: [id])
  system_quantity     Decimal
  physical_count      Decimal?
  change_quantity     Decimal?
  difference          Decimal
  adjustment_type     StockAdjustmentType     @default(RECONCILIATION)
  adjustment_category StockAdjustmentCategory @default(CORRECTION)
  reason              String?
  reference_no        String?
  adjustment_date     DateTime                @default(now())
  adjusted_by         String
  user                User                    @relation(fields: [adjusted_by], references: [id])
  created_at          DateTime                @default(now())

  @@index([product_id])
  @@index([branch_id])
  @@index([adjustment_date])
  @@index([adjustment_type])
  @@index([adjustment_category])
}

// NEW: Sales/Sell Table
model Sale {
  id               String        @id @default(uuid())
  sale_number      String        @unique
  invoice_number   String?       @unique
  branch_id        String?
  branch           Branch?       @relation(fields: [branch_id], references: [id])
  customer_id      String?
  customer         Customer?     @relation(fields: [customer_id], references: [id])
  sale_date        DateTime      @default(now())
  subtotal         Decimal       @default(0)
  tax_amount       Decimal       @default(0)
  discount_amount  Decimal       @default(0)
  total_amount     Decimal
  payment_method   PaymentMethod @default(CASH)
  payment_status   PaymentStatus @default(PAID)
  payment_received Decimal       @default(0)
  change_amount    Decimal       @default(0)
  notes            String?
  status           SaleStatus    @default(COMPLETED)
  created_by       String?
  user             User?         @relation(fields: [created_by], references: [id])
  sale_items       SaleItem[]
  original_sale_id String?
  original_sale    Sale?         @relation("SaleReturnLink", fields: [original_sale_id], references: [id])
  return_sales     Sale[]        @relation("SaleReturnLink")
  customer_payments CustomerPayment[] @relation("CustomerPaymentSale")
  // Promotions, loyalty and gift cards applied at checkout (discount_amount includes promotion + loyalty)
  promotion_discount      Decimal               @default(0)
  applied_promotions      Json?
  loyalty_points_redeemed Int                   @default(0)
  loyalty_discount        Decimal               @default(0)
  loyalty_points_earned   Int                   @default(0)
  loyalty_transactions    LoyaltyTransaction[]
  gift_card_transactions  GiftCardTransaction[]
  // Split tenders (cash + card + bank + wallet). Empty for older single-method sales.
  payments         SalePayment[]
  // Void / cancellation audit
  void_reason      String?
  voided_by        String?
  voided_at        DateTime?
  // Employee credited with this sale for commission (null = cashier's linked employee)
  salesperson_id   String?
  salesperson      Employee?     @relation("SaleSalesperson", fields: [salesperson_id], references: [id], onDelete: SetNull)
  created_at       DateTime      @default(now())
  updated_at       DateTime      @default(now()) @updatedAt

  @@index([sale_number])
  @@index([invoice_number])
  @@index([branch_id])
  @@index([customer_id])
  @@index([sale_date])
  @@index([status])
  @@index([created_by])
  @@index([salesperson_id])
}

enum SaleItemType {
  ORIGINAL
  RETURN
  EXCHANGE
}

// NEW: Sale Items
model SaleItem {
  id               String       @id @default(uuid())
  sale_id          String
  sale             Sale         @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  product_id       String
  product          Product      @relation(fields: [product_id], references: [id])
  quantity         Decimal
  unit_price       Decimal
  tax_rate         Decimal      @default(0)
  tax_amount       Decimal      @default(0)
  discount_rate    Decimal      @default(0)
  discount_amount  Decimal      @default(0)
  line_total       Decimal
  item_type        SaleItemType @default(ORIGINAL)
  ref_sale_item_id String?
  created_at       DateTime     @default(now())

  @@index([sale_id])
  @@index([product_id])
}

// NEW: Purchase Orders
model PurchaseOrder {
  id                   String              @id @default(uuid())
  po_number            String              @unique
  branch_id            String
  branch               Branch              @relation(fields: [branch_id], references: [id])
  supplier_id          String
  supplier             Supplier            @relation(fields: [supplier_id], references: [id])
  order_date           DateTime            @default(now())
  expected_delivery    DateTime?
  delivery_date        DateTime?
  status               PurchaseOrderStatus @default(PENDING)
  subtotal             Decimal             @default(0)
  tax_amount           Decimal             @default(0)
  total_amount         Decimal             @default(0)
  notes                String?
  created_by           String
  user                 User                @relation(fields: [created_by], references: [id])
  purchase_order_items PurchaseOrderItem[]
  purchases            Purchase[]
  purchase_returns     PurchaseReturn[]
  purchase_invoices    PurchaseInvoice[]
  created_at           DateTime            @default(now())
  updated_at           DateTime            @default(now()) @updatedAt

  @@index([po_number])
  @@index([branch_id])
  @@index([supplier_id])
  @@index([status])
  @@index([order_date])
}

enum PurchaseReturnStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model PurchaseReturn {
  id                String               @id @default(uuid())
  return_number     String               @unique
  supplier_id       String
  supplier          Supplier             @relation(fields: [supplier_id], references: [id])
  branch_id         String
  branch            Branch               @relation("PurchaseReturnBranch", fields: [branch_id], references: [id])
  purchase_order_id String?
  purchase_order    PurchaseOrder?       @relation(fields: [purchase_order_id], references: [id])
  return_date       DateTime             @default(now())
  status            PurchaseReturnStatus @default(COMPLETED)
  reason            String?
  notes             String?
  total_amount      Decimal              @default(0)
  created_by        String
  user              User                 @relation("PurchaseReturnCreator", fields: [created_by], references: [id])
  items             PurchaseReturnItem[]
  created_at        DateTime             @default(now())
  updated_at        DateTime             @default(now()) @updatedAt

  @@index([supplier_id])
  @@index([branch_id])
  @@index([return_date])
  @@index([status])
}

model PurchaseReturnItem {
  id                 String         @id @default(uuid())
  purchase_return_id String
  purchase_return    PurchaseReturn @relation(fields: [purchase_return_id], references: [id], onDelete: Cascade)
  product_id         String
  product            Product        @relation(fields: [product_id], references: [id])
  quantity           Decimal
  unit_cost          Decimal
  total_cost         Decimal
  purchase_id        String?
  purchase           Purchase?      @relation(fields: [purchase_id], references: [id])

  @@index([purchase_return_id])
  @@index([product_id])
}

// NEW: Purchase Order Items
model PurchaseOrderItem {
  id                String        @id @default(uuid())
  purchase_order_id String
  purchase_order    PurchaseOrder @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade)
  product_id        String
  product           Product       @relation(fields: [product_id], references: [id])
  ordered_quantity  Decimal
  received_quantity Decimal           @default(0)
  unit_cost         Decimal
  total_cost        Decimal
  created_at        DateTime      @default(now())

  @@index([purchase_order_id])
  @@index([product_id])
}

model Area {
  id         String     @id @default(uuid())
  code       String     @unique
  name       String
  customers  Customer[]
  created_at DateTime   @default(now())

  @@index([code])
}

model Customer {
  id                 String          @id @default(uuid())
  name               String?
  area_id            String?
  area               Area?           @relation(fields: [area_id], references: [id])
  address            String?
  billing_address    String?
  phone_number       String?
  gender             String?
  ntn                String?
  mobile_number      String?
  strn               String?
  email              String?
  password           String?
  dob                DateTime?
  customer_cat       String[]
  gov_id             String?
  customer_tags      String[]
  is_active          Boolean         @default(true)
  ref_by             String?
  ref_contact_number String?
  credit_limit       Decimal?
  previous_credit_balance Decimal?     @default(0)
  default_discount_percent Decimal?    @default(0)
  /// Payment terms: credit sales fall due this many days after the sale (null = due immediately)
  credit_days        Int?
  notes              String?
  orders             Order[]
  sales              Sale[] // NEW: Link to sales
  hold_sales         HoldSale[]
  payments           CustomerPayment[]
  loyalty_transactions LoyaltyTransaction[]
  gift_cards         GiftCard[]
  device             DeviceIdentity?
  created_at         DateTime        @default(now())
  updated_at         DateTime        @default(now()) @updatedAt

  @@index([area_id])
  @@index([is_active])
}

enum CustomerTxnType {
  PAYMENT
  ADVANCE
  REFUND
  CREDIT_NOTE
  DEBIT_NOTE
  WRITE_OFF
}

/// Customer account transactions. PAYMENT / ADVANCE / CREDIT_NOTE / WRITE_OFF reduce
/// what the customer owes (credit); REFUND / DEBIT_NOTE increase it (debit).
model CustomerPayment {
  id           String   @id @default(uuid())
  customer_id  String
  customer     Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  type         CustomerTxnType @default(PAYMENT)
  /// Optional invoice this transaction settles / adjusts
  sale_id      String?
  sale         Sale?    @relation("CustomerPaymentSale", fields: [sale_id], references: [id], onDelete: SetNull)
  amount       Decimal
  payment_date DateTime @default(now())
  method       String   @default("CASH")
  reference    String?
  notes        String?
  created_by   String
  user         User     @relation(fields: [created_by], references: [id])
  created_at   DateTime @default(now())

  @@index([customer_id])
  @@index([payment_date])
  @@index([created_by])
  @@index([type])
  @@index([sale_id])
}

model Discount {
  id         String       @id @default(uuid())
  name       String
  value      Decimal
  type       DiscountType
  is_active  Boolean      @default(true)
  created_at DateTime     @default(now())

  @@index([is_active])
}

model HoldSale {
  id          String    @id @default(uuid())
  branch_id   String
  branch      Branch    @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  customer_id String?
  customer    Customer? @relation(fields: [customer_id], references: [id])
  created_by  String?
  user        User?     @relation(fields: [created_by], references: [id])
  items       Json
  subtotal    Decimal   @default(0)
  total_items Int       @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now()) @updatedAt

  @@index([branch_id])
  @@index([customer_id])
  @@index([created_by])
  @@index([created_at])
}

model Order {
  id             String         @id @default(uuid())
  branch_id      String?
  branch         Branch?        @relation(fields: [branch_id], references: [id])
  customer_id    String?
  customer       Customer?      @relation(fields: [customer_id], references: [id])
  customer_name  String?
  customer_email String?
  customer_phone String?
  delivery_address String?
  delivery_city  String?
  delivery_postal_code String?
  order_notes    String?
  order_number   String         @unique
  items          OrderItem[]
  total_amount   Decimal
  status         OrderStatus    @default(PENDING)
  payment_method PaymentMethod?
  payment_status PaymentStatus  @default(PENDING)
  apg_transaction_id String?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @default(now()) @updatedAt

  @@index([customer_id])
  @@index([order_number])
  @@index([status])
  @@index([payment_status])
  @@index([created_at])
}

model OrderItem {
  id           String   @id @default(uuid())
  order_id     String
  order        Order    @relation(fields: [order_id], references: [id])
  product_id   String
  product      Product  @relation(fields: [product_id], references: [id])
  display_name    String?
  grams_per_unit  Decimal?
  unit_name       String?
  quantity        Decimal
  price           Decimal
  total_price     Decimal
  created_at   DateTime @default(now())

  @@index([order_id])
  @@index([product_id])
}

model DeviceIdentity {
  id          String    @id @default(uuid())
  fcm_token   String
  customer_id String?   @unique
  customer    Customer? @relation(fields: [customer_id], references: [id])
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now()) @updatedAt

  @@unique([fcm_token, customer_id])
  @@index([customer_id])
  @@index([fcm_token])
}

// ENUMS
enum Role {
  ADMIN
  SUPER_ADMIN
  PURCHASE_MANAGER
  WAREHOUSE_MANAGER
  BRANCH_MANAGER
  SUPERVISOR
  CASHIER
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  BANK_TRANSFER
  CREDIT
  GIFT_CARD
}

enum DiscountType {
  FLAT
  PERCENTAGE
}

// NEW ENUMS
enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
  EXCHANGED
}

enum PaymentStatus {
  PAID
  PARTIAL
  PENDING
  OVERDUE
  FAILED
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
  PURCHASE_RETURN
  DAMAGE
  EXPIRED
  LOSS
}

enum PurchaseOrderStatus {
  PENDING
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ExpensePaymentMethod {
  CASH
  BANK
  CARD
  MOBILE_MONEY
  CHEQUE
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

model ExpenseCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  expenses  Expense[]
  recurring RecurringExpense[]
  chart_account TransactionalAccount?
}

model Expense {
  id         String   @id @default(uuid())
  particular String
  amount     Decimal
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  cashflow_id String?
  cashflow    CashFlow? @relation(fields: [cashflow_id], references: [id])

  category_id String?
  category    ExpenseCategory? @relation(fields: [category_id], references: [id])

  payment_method   ExpensePaymentMethod @default(CASH)
  bank_account     String?
  reference        String?
  vendor           String?
  notes            String?
  expense_date     DateTime            @default(now())

  status           ExpenseStatus @default(PENDING)
  approved_by      String?
  approver         User?         @relation("ExpenseApprover", fields: [approved_by], references: [id])
  approved_at      DateTime?
  rejection_reason String?

  branch_id String?
  branch    Branch? @relation(fields: [branch_id], references: [id])

  created_by String?
  creator    User?   @relation("ExpenseCreator", fields: [created_by], references: [id])

  recurring_id String?
  recurring    RecurringExpense? @relation(fields: [recurring_id], references: [id])

  // Chart of Accounts expense head this expense posts to
  account_id String?
  account    TransactionalAccount? @relation(fields: [account_id], references: [id])

  attachments ExpenseAttachment[]

  @@index([status])
  @@index([account_id])
  @@index([expense_date])
  @@index([category_id])
  @@index([branch_id])
}

model RecurringExpense {
  id             String              @id @default(uuid())
  particular     String
  amount         Decimal
  payment_method ExpensePaymentMethod @default(CASH)
  bank_account   String?
  vendor         String?
  notes          String?

  category_id String?
  category    ExpenseCategory? @relation(fields: [category_id], references: [id])

  account_id String?
  account    TransactionalAccount? @relation(fields: [account_id], references: [id])

  branch_id String?
  branch    Branch? @relation(fields: [branch_id], references: [id])

  frequency     RecurringFrequency @default(MONTHLY)
  interval      Int                @default(1)
  start_date    DateTime           @default(now())
  end_date      DateTime?
  next_run_date DateTime
  last_run_date DateTime?
  is_active     Boolean            @default(true)
  auto_approve  Boolean            @default(false)

  created_by String?
  creator    User?   @relation("RecurringExpenseCreator", fields: [created_by], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime  @default(now()) @updatedAt
  generated  Expense[]

  @@index([is_active])
  @@index([next_run_date])
}

model CashFlow {
  id         String    @id @default(uuid())
  user_id    String?
  user       User?     @relation(fields: [user_id], references: [id])
  branch_id  String?
  branch     Branch?   @relation(fields: [branch_id], references: [id])
  opening    Decimal
  sales      Decimal
  closing    Decimal? // nullable until closing added
  expected_cash Decimal?
  variance      Decimal?
  status     CashFlowStatus @default(OPEN)
  opened_at  DateTime  @default(now())
  closed_at  DateTime?
  closed_by  String?
  closer     User?     @relation("CashFlowCloser", fields: [closed_by], references: [id])
  created_at DateTime  @default(now())
  expenses   Expense[]

  // Opening count vs last closing
  expected_opening    Decimal?
  opening_variance    Decimal?
  opening_note        String?
  /// Denomination count, e.g. {"5000":2,"1000":5,"coins":120}
  opening_count       Json?
  closing_count       Json?
  // Closing difference explanation / approval
  variance_note       String?
  variance_approved_by String?
  /// NONE | PENDING | APPROVED — manager review after closing
  review_status       String    @default("NONE")
  reviewed_by         String?
  reviewed_at         DateTime?
  review_note         String?
  /// Locked while the cashier is on a break with no cover
  locked              Boolean   @default(false)
  locked_reason       String?

  cash_movements  CashMovement[]
  shifts          RegisterShift[]
  reconciliations RegisterReconciliation[]
}

/// Cash added to the drawer during a session (float top-up, change from bank…).
model CashMovement {
  id          String   @id @default(uuid())
  cashflow_id String
  cashflow    CashFlow @relation(fields: [cashflow_id], references: [id], onDelete: Cascade)
  type        String   @default("IN")
  amount      Decimal
  reason      String
  created_by  String?
  approved_by String?
  created_at  DateTime @default(now())

  @@index([cashflow_id])
}

/// Who was responsible for the drawer and when. Every handover / break is a new row.
model RegisterShift {
  id                    String    @id @default(uuid())
  cashflow_id           String
  cashflow              CashFlow  @relation(fields: [cashflow_id], references: [id], onDelete: Cascade)
  cashier_id            String
  /// OPENING | HANDOVER | BREAK_COVER | RETURN | EMERGENCY
  kind                  String
  /// ACTIVE | ON_BREAK | ENDED
  status                String    @default("ACTIVE")
  started_at            DateTime  @default(now())
  ended_at              DateTime?
  start_count           Decimal
  end_count             Decimal?
  expected_end          Decimal?
  variance              Decimal?
  start_note            String?
  end_note              String?
  confirmed_by_incoming Boolean   @default(false)
  approved_by           String?
  ended_by              String?
  created_at            DateTime  @default(now())

  @@index([cashflow_id])
  @@index([cashier_id])
}

/// Card / bank / wallet totals checked against terminal or bank statement at closing.
model RegisterReconciliation {
  id            String   @id @default(uuid())
  cashflow_id   String
  cashflow      CashFlow @relation(fields: [cashflow_id], references: [id], onDelete: Cascade)
  /// CASH | CARD | BANK_TRANSFER | MOBILE_MONEY
  method        String
  expected      Decimal
  actual        Decimal
  variance      Decimal
  reference     String?
  notes         String?
  reconciled_by String?
  created_at    DateTime @default(now())

  @@unique([cashflow_id, method])
}

enum CashFlowStatus {
  OPEN
  CLOSED
}

// Staff Management
enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

model Department {
  id         String     @id @default(uuid())
  name       String     @unique
  is_active  Boolean    @default(true)
  employees  Employee[]
  created_at DateTime   @default(now())
  updated_at DateTime   @default(now()) @updatedAt
}

model Employee {
  id           String   @id @default(uuid())
  employee_code String? @unique
  name         String
  email        String?  @unique
  phone_number String?
  cnic         String?  @unique
  gender       String?
  join_date    DateTime
  is_active    Boolean  @default(true) // keep for backward compat; sync with status
  status       EmployeeStatus @default(ACTIVE)
  employment_type EmploymentType @default(FULL_TIME)
  date_of_birth DateTime?
  address      String?
  personal_email String?
  emergency_name String?
  emergency_phone String?
  photo_url    String?
  deactivated_at DateTime?
  deactivated_reason String?

  branch_id String?
  branch    Branch? @relation(fields: [branch_id], references: [id])

  department_id String?
  department    Department? @relation(fields: [department_id], references: [id])

  employee_type_id  String
  employee_type     EmployeeType      @relation(fields: [employee_type_id], references: [id])

  reporting_manager_id String?
  reporting_manager    Employee?  @relation("EmployeeManager", fields: [reporting_manager_id], references: [id])
  direct_reports       Employee[] @relation("EmployeeManager")

  shift_assignments ShiftAssignment[]
  salaries          Salary[]
  commissions       Commission[]
  chart_account     TransactionalAccount?
  advances          EmployeeAdvance[]

  // Link POS login user so sales (Sale.created_by) map to this employee for commission
  user_id String? @unique
  user    User?   @relation(fields: [user_id], references: [id])

  // Fixed monthly base salary; commission is earned separately as an addon
  monthly_salary Decimal @default(0)

  // How commission is earned: % of net sales, a fixed amount per bill, or per piece sold
  commission_type  CommissionType @default(PERCENTAGE)
  // Commission % of net sales (e.g. 2.5 = 2.5%) — used when commission_type = PERCENTAGE
  commission_rate Decimal @default(0)
  // Fixed Rs per bill / per piece — used for the FIXED_* commission types
  commission_fixed Decimal @default(0)

  // Sales where this employee was picked as the salesperson
  attributed_sales Sale[] @relation("SaleSalesperson")

  // Optional bank / payout account details
  bank_name       String?
  account_title   String?
  account_number  String?
  iban            String?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@index([branch_id])
  @@index([employee_type_id])
  @@index([department_id])
  @@index([status])
  @@index([employee_code])
}

enum CommissionType {
  PERCENTAGE
  FIXED_PER_SALE
  FIXED_PER_PIECE
}

model EmployeeType {
  id        String  @id @default(uuid())
  name      String  @unique
  is_active Boolean @default(true)
  employees Employee[]
}

model Shift {
  id         String   @id @default(uuid())
  name       String
  start_time DateTime
  end_time   DateTime
  is_active  Boolean  @default(true)
}

model ShiftAssignment {
  id          String    @id @default(uuid())
  employee_id String
  shift_time  String
  start_date  DateTime
  end_date    DateTime?
  sales       Float     @default(0)
  break_time  String?   @default("1 hour")
  employee Employee @relation(fields: [employee_id], references: [id])
  @@unique([employee_id,start_date])
}

model Salary {
  id          String    @id @default(uuid())
  employee_id String
  month       Int
  year        Int
  amount      Decimal
  // Advance / loan taken against this pay period
  loan_amount Decimal   @default(0)
  // Payslip breakdown: net = amount + bonus + allowances - deductions - advance_deduction - loan_amount
  bonus             Decimal @default(0)
  allowances        Decimal @default(0)
  deductions        Decimal @default(0)
  // Recovery of an outstanding advance (creates a RECOVERY entry in EmployeeAdvance)
  advance_deduction Decimal @default(0)
  paid_amount       Decimal @default(0)
  payment_method    String?
  reference         String?
  is_paid     Boolean   @default(false)
  paid_date   DateTime?
  notes       String?
  employee Employee @relation(fields: [employee_id], references: [id])
  advance_entries EmployeeAdvance[]
  created_at DateTime @default(now())
  @@unique([employee_id, month, year])
  @@index([employee_id])
  @@index([paid_date])
  @@index([is_paid])
}

model Commission {
  id            String    @id @default(uuid())
  employee_id   String
  month         Int
  year          Int
  sales_amount  Decimal   @default(0)
  pieces        Decimal   @default(0)
  bills         Int       @default(0)
  rate          Decimal   @default(0)
  commission_type CommissionType @default(PERCENTAGE)
  fixed_amount  Decimal   @default(0)
  amount        Decimal   @default(0)
  is_paid       Boolean   @default(false)
  paid_date     DateTime?
  notes         String?
  employee      Employee  @relation(fields: [employee_id], references: [id])
  created_at    DateTime  @default(now())
  updated_at    DateTime  @default(now()) @updatedAt

  @@unique([employee_id, month, year])
  @@index([employee_id])
  @@index([paid_date])
  @@index([is_paid])
}

// ============================================================
// Chart of Accounts
// Level 1 Type (fixed: 1 Asset, 2 Liability, 3 Equity, 4 Income, 5 Expense)
// Level 2 Sub Type (2 digits, e.g. 52)
// Level 3 Control Account (3 digits, e.g. 522)
// Level 4 Transactional Account (7 digits, e.g. 5220001)
// ============================================================

enum BalanceSide {
  DEBIT
  CREDIT
}

model AccountSubType {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  type_code   Int
  description String?
  is_active   Boolean          @default(true)
  is_system   Boolean          @default(false)
  controls    ControlAccount[]
  created_at  DateTime         @default(now())
  updated_at  DateTime         @default(now()) @updatedAt

  @@index([type_code])
}

model ControlAccount {
  id          String                 @id @default(uuid())
  code        String                 @unique
  name        String
  sub_type_id String
  sub_type    AccountSubType         @relation(fields: [sub_type_id], references: [id])
  description String?
  /// Marks controls that auto-linked accounts are created under (PAYROLL, TRADE_PAYABLES, GENERAL_EXPENSES)
  system_key  String?                @unique
  is_active   Boolean                @default(true)
  is_system   Boolean                @default(false)
  accounts    TransactionalAccount[]
  created_at  DateTime               @default(now())
  updated_at  DateTime               @default(now()) @updatedAt

  @@index([sub_type_id])
}

model TransactionalAccount {
  id              String         @id @default(uuid())
  code            String         @unique
  name            String
  control_id      String
  control         ControlAccount @relation(fields: [control_id], references: [id])
  contact_person  String?
  mobile          String?
  address         String?
  nic             String?
  ntn             String?
  email           String?
  notes           String?
  opening_balance Decimal        @default(0)
  opening_side    BalanceSide    @default(DEBIT)
  is_active       Boolean        @default(true)
  is_system       Boolean        @default(false)
  /// Values computed from POS modules (CASH, INVENTORY, SALES, COGS, ...)
  system_key      String?        @unique

  employee_id String?   @unique
  employee    Employee? @relation(fields: [employee_id], references: [id], onDelete: SetNull)

  supplier_id String?   @unique
  supplier    Supplier? @relation(fields: [supplier_id], references: [id], onDelete: SetNull)

  expense_category_id String?          @unique
  expense_category    ExpenseCategory? @relation(fields: [expense_category_id], references: [id], onDelete: SetNull)

  expenses           Expense[]
  recurring_expenses RecurringExpense[]
  budgets            Budget[]
  journal_lines      JournalVoucherLine[]

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@index([control_id])
  @@index([is_active])
}

model JournalVoucher {
  id           String               @id @default(uuid())
  voucher_no   String               @unique
  voucher_date DateTime             @default(now())
  narration    String?
  reference    String?
  branch_id    String?
  total        Decimal              @default(0)
  created_by   String?
  lines        JournalVoucherLine[]
  created_at   DateTime             @default(now())
  updated_at   DateTime             @default(now()) @updatedAt

  @@index([voucher_date])
  @@index([branch_id])
}

model JournalVoucherLine {
  id          String               @id @default(uuid())
  voucher_id  String
  voucher     JournalVoucher       @relation(fields: [voucher_id], references: [id], onDelete: Cascade)
  account_id  String
  account     TransactionalAccount @relation(fields: [account_id], references: [id])
  description String?
  debit       Decimal              @default(0)
  credit      Decimal              @default(0)

  @@index([voucher_id])
  @@index([account_id])
}

enum AdvanceTxnType {
  ADVANCE
  RECOVERY
}

/// Staff advances / loans. ADVANCE = money given to the employee; RECOVERY = repaid in cash or deducted from salary.
model EmployeeAdvance {
  id          String         @id @default(uuid())
  employee_id String
  employee    Employee       @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  type        AdvanceTxnType
  amount      Decimal
  txn_date    DateTime       @default(now())
  method      String         @default("CASH")
  reference   String?
  notes       String?
  /// Set when the recovery came out of a salary (payroll deduction)
  salary_id   String?
  salary      Salary?        @relation(fields: [salary_id], references: [id], onDelete: Cascade)
  created_by  String?
  created_at  DateTime       @default(now())

  @@index([employee_id])
  @@index([txn_date])
  @@index([salary_id])
}

/// One tender on a sale. Amounts are what was applied to the bill (cash is net of change).
model SalePayment {
  id         String        @id @default(uuid())
  sale_id    String
  sale       Sale          @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  method     PaymentMethod
  amount     Decimal
  reference  String?
  created_at DateTime      @default(now())

  @@index([sale_id])
  @@index([method])
}

/// Every change to a product's cost or selling price.
model ProductPriceHistory {
  id         String   @id @default(uuid())
  product_id String
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  /// purchase_rate | sales_rate_exc_dis_and_tax | sales_rate_inc_dis_and_tax | discount_amount
  field      String
  old_value  Decimal
  new_value  Decimal
  source     String   @default("MANUAL")
  changed_by String?
  created_at DateTime @default(now())

  @@index([product_id])
  @@index([created_at])
}

/// Per-role permission overrides. Missing rows fall back to the built-in defaults.
model RolePermission {
  role       Role
  permission String
  allowed    Boolean
  updated_by String?
  updated_at DateTime @default(now()) @updatedAt

  @@id([role, permission])
}

/// Who did what, when — logins, sales edits, voids, refunds, price changes, cash moves, approvals, exports…
model AuditLog {
  id                String   @id @default(uuid())
  created_at        DateTime @default(now())
  user_id           String?
  user_email        String?
  user_role         String?
  branch_id         String?
  /// Dotted action key, e.g. sale.void, product.price_change, auth.login
  action            String
  /// sales | inventory | cash | expenses | customers | suppliers | staff | security | reports | accounts | settings
  category          String
  entity            String?
  entity_id         String?
  summary           String
  details           Json?
  approved_by_id    String?
  approved_by_email String?
  ip                String?
  user_agent        String?
  status_code       Int?

  @@index([created_at])
  @@index([user_id])
  @@index([action])
  @@index([category])
  @@index([entity_id])
}

// Receipt / bill photos and PDFs attached to an expense
model ExpenseAttachment {
  id          String   @id @default(uuid())
  expense_id  String
  expense     Expense  @relation(fields: [expense_id], references: [id], onDelete: Cascade)
  url         String
  name        String
  mime_type   String?
  size        Int?
  uploaded_by String?
  created_at  DateTime @default(now())

  @@index([expense_id])
}

// Books are closed up to lock_until (inclusive, business date). Only the latest active lock applies.
model PeriodLock {
  id            String    @id @default(uuid())
  lock_until    String // YYYY-MM-DD
  note          String?
  locked_by     String?
  is_active     Boolean   @default(true)
  reopened_by   String?
  reopened_at   DateTime?
  reopen_reason String?
  created_at    DateTime  @default(now())

  @@index([is_active])
}

// Monthly budget per expense account (branch optional = whole shop)
model Budget {
  id         String               @id @default(uuid())
  account_id String
  account    TransactionalAccount @relation(fields: [account_id], references: [id], onDelete: Cascade)
  branch_id  String?
  year       Int
  month      Int
  amount     Decimal              @default(0)
  notes      String?
  created_by String?
  created_at DateTime             @default(now())
  updated_at DateTime             @default(now()) @updatedAt

  @@index([year, month])
  @@index([account_id])
}

// A report view (report + filters) saved by a user, optionally shared with everyone
model SavedReport {
  id         String   @id @default(uuid())
  user_id    String
  name       String
  report     String
  params     Json
  is_shared  Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@index([user_id])
}

// Key/value settings (loyalty programme rules etc.)
model AppSetting {
  key        String   @id
  value      Json
  updated_by String?
  updated_at DateTime @default(now()) @updatedAt
}

// Loyalty points ledger: balance = sum(points)
model LoyaltyTransaction {
  id          String   @id @default(uuid())
  customer_id String
  customer    Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  sale_id     String?
  sale        Sale?    @relation(fields: [sale_id], references: [id], onDelete: SetNull)
  type        String // EARN | REDEEM | ADJUST | REVERSE | EXPIRE
  points      Int
  value       Decimal  @default(0)
  note        String?
  created_by  String?
  created_at  DateTime @default(now())

  @@index([customer_id])
  @@index([sale_id])
  @@index([created_at])
}

model GiftCard {
  id            String                @id @default(uuid())
  code          String                @unique
  initial_value Decimal
  balance       Decimal
  status        String                @default("ACTIVE") // ACTIVE | USED | EXPIRED | VOID
  customer_id   String?
  customer      Customer?             @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  holder_name   String?
  holder_phone  String?
  expires_at    DateTime?
  notes         String?
  branch_id     String?
  created_by    String?
  created_at    DateTime              @default(now())
  updated_at    DateTime              @default(now()) @updatedAt
  transactions  GiftCardTransaction[]

  @@index([status])
  @@index([customer_id])
}

model GiftCardTransaction {
  id             String   @id @default(uuid())
  card_id        String
  card           GiftCard @relation(fields: [card_id], references: [id], onDelete: Cascade)
  type           String // ISSUE | RELOAD | REDEEM | REFUND | VOID | ADJUST
  amount         Decimal // + adds to balance, - spends
  payment_method String?
  sale_id        String?
  sale           Sale?    @relation(fields: [sale_id], references: [id], onDelete: SetNull)
  cashflow_id    String?
  note           String?
  created_by     String?
  created_at     DateTime @default(now())

  @@index([card_id])
  @@index([sale_id])
  @@index([created_at])
}

model Promotion {
  id           String    @id @default(uuid())
  name         String
  description  String?
  type         String // ITEM_PERCENT | ITEM_FIXED | BUY_X_GET_Y | BILL_PERCENT | BILL_FIXED
  value        Decimal   @default(0)
  buy_qty      Int?
  get_qty      Int?
  scope        String    @default("ALL") // ALL | CATEGORY | BRAND | PRODUCT | COLLECTION
  scope_ids    Json?
  min_bill     Decimal?
  max_discount Decimal?
  code         String? // coupon code; null = applies automatically
  starts_at    DateTime  @default(now())
  ends_at      DateTime?
  days_of_week Json?
  branch_ids   Json?
  usage_limit  Int?
  used_count   Int       @default(0)
  priority     Int       @default(0)
  stackable    Boolean   @default(false)
  is_active    Boolean   @default(true)
  created_by   String?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @default(now()) @updatedAt

  @@index([is_active])
  @@index([code])
}
